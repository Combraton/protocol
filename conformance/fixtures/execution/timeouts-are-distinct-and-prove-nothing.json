{
  "format": "combraton-conformance-fixture/1",
  "id": "execution.timeouts-are-distinct-and-prove-nothing",
  "version": 1,
  "title": "Delivery and execution-deadline timeouts pass separately; an overdue obligation leaves the effect's status unchanged",
  "requirements": [
    "EXE-19",
    "EFF-4",
    "REL-12"
  ],
  "spec_refs": [
    "docs/spec/profiles/EXECUTION.md#8-timeouts",
    "docs/spec/profiles/CORE.md#19-effects-and-obligations-proposed-m3-draft"
  ],
  "role": "provider",
  "profiles": [
    {
      "name": "execution",
      "major": 1
    }
  ],
  "features": [
    "core.events",
    "core.capabilities",
    "core.effects"
  ],
  "requires_controls": [
    "executor.script",
    "clock.file"
  ],
  "polarity": "negative",
  "kills": [
    "timeouts-collapsed",
    "deadline-marks-effect-failed"
  ],
  "kill_expectations": {
    "timeouts-collapsed": {
      "step": 5,
      "reason_contains": "result/items"
    },
    "deadline-marks-effect-failed": {
      "step": 9,
      "reason_contains": "result/status"
    }
  },
  "steps": [
    {
      "step": "start",
      "config": {
        "principal": "owner",
        "authority_principals": [
          "owner"
        ],
        "executor": {
          "scripts": {
            "e-1": [
              {
                "stall": true
              }
            ]
          }
        },
        "clock": {
          "controlled": "2030-01-01T00:00:00Z"
        }
      }
    },
    {
      "step": "negotiate",
      "payload": {
        "caller": {
          "name": "fixture",
          "version": "1"
        },
        "receive_limits": {
          "max_frame_bytes": 1048576
        },
        "profiles": [
          {
            "name": "core",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [
              "core.events",
              "core.capabilities",
              "core.effects"
            ],
            "optional_features": []
          },
          {
            "name": "execution",
            "majors": [
              1
            ],
            "required": true,
            "required_features": [],
            "optional_features": []
          }
        ]
      }
    },
    {
      "step": "command",
      "operation": "execution.submit",
      "command_id": "submit-e-1",
      "subject": {
        "kind": "execution.execution",
        "id": "e-1"
      },
      "preconditions": [
        {
          "subject": {
            "kind": "execution.execution",
            "id": "e-1"
          },
          "revision": 0
        }
      ],
      "payload": {
        "brief": {
          "digest": "sha256:abababababababababababababababababababababababababababababababab",
          "media_type": "text/plain"
        },
        "timeouts": {
          "delivery": 60,
          "execution_deadline": 3600
        }
      }
    },
    {
      "step": "set_clock",
      "instant": "2030-01-01T00:01:00Z"
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "delivery": "pending",
          "obligations": [
            {
              "id": "e-1.delivery-1.evidence",
              "state": "overdue",
              "deadline": "2030-01-01T00:01:00Z"
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "type": "execution.admission.changed"
              }
            },
            {
              "event": {
                "type": "execution.timeout.passed",
                "payload": {
                  "timeout": "delivery"
                }
              }
            },
            {
              "event": {
                "type": "core.effect.obligation.overdue",
                "payload": {
                  "effect": "e-1.delivery-1"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "core.effects.get",
      "payload": {
        "effect": "e-1.delivery-1"
      },
      "expect": {
        "ok": {
          "status": "pending"
        }
      }
    },
    {
      "step": "set_clock",
      "instant": "2030-01-01T01:00:00Z"
    },
    {
      "step": "query",
      "operation": "core.events.read",
      "payload": {
        "from": "start",
        "limit": 100,
        "kinds": [
          "execution.execution"
        ]
      },
      "expect": {
        "ok": {
          "items": [
            {
              "event": {
                "type": "execution.admission.changed"
              }
            },
            {
              "event": {
                "type": "execution.timeout.passed",
                "payload": {
                  "timeout": "delivery"
                }
              }
            },
            {
              "event": {
                "type": "core.effect.obligation.overdue"
              }
            },
            {
              "event": {
                "type": "execution.timeout.passed",
                "payload": {
                  "timeout": "execution_deadline"
                }
              }
            }
          ]
        }
      }
    },
    {
      "step": "query",
      "operation": "core.effects.get",
      "payload": {
        "effect": "e-1.delivery-1"
      },
      "expect": {
        "ok": {
          "status": "pending"
        }
      }
    },
    {
      "step": "query",
      "operation": "execution.inspect",
      "payload": {
        "execution": "e-1"
      },
      "expect": {
        "ok": {
          "runtime": "preparing"
        }
      }
    },
    {
      "step": "stop"
    }
  ]
}
