{
  "format": "combraton-conformance-participant/1",
  "name": "combraton-independent-python-core",
  "version": "0.1.0-dev.0",
  "description": "Independent spec-only Core, Execution, Evidence and Context provider in Python (standard library only; not a product). Written from the published documents and schemas without reading the reference provider. See conformance/independent/python-core/README.md.",
  "role": "provider",
  "binding": "stdio",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      },
      {
        "name": "execution",
        "major": 1
      },
      {
        "name": "evidence",
        "major": 1
      },
      {
        "name": "context",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities",
      "core.effects",
      "execution.steering",
      "execution.actions",
      "execution.controller",
      "execution.workspaces",
      "execution.usage",
      "execution.context",
      "execution.discovery",
      "execution.continuation",
      "execution.output",
      "execution.context_revalidation",
      "evidence.manifests",
      "evidence.retention_control",
      "context.advisory",
      "context.required_before_start",
      "context.required_before_transition",
      "context.shared_jobs",
      "context.updates",
      "context.expand"
    ],
    "test_controls": [
      "clock.file",
      "executor.script",
      "store.faults",
      "evidence.store",
      "context.script"
    ]
  },
  "launch": {
    "argv": [
      "python3",
      "{repo}/conformance/independent/python-core/provider.py",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}"
    ]
  },
  "mutants": {
    "argv": [],
    "names": []
  }
}
