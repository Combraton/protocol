{
  "format": "combraton-conformance-participant/1",
  "name": "combraton-reference-provider-unix",
  "version": "0.1.0-dev.0",
  "description": "Reference Core provider over the Unix-socket binding (not a product). Build first: cargo build -p combraton-reference-provider",
  "role": "provider",
  "binding": "unix",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      },
      {
        "name": "execution",
        "major": 1
      },
      {
        "name": "evidence",
        "major": 1
      },
      {
        "name": "context",
        "major": 1
      },
      {
        "name": "knowledge",
        "major": 1
      },
      {
        "name": "verification",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities",
      "core.effects",
      "execution.steering",
      "execution.actions",
      "execution.controller",
      "execution.workspaces",
      "execution.usage",
      "execution.context",
      "execution.discovery",
      "execution.continuation",
      "core.events.backpressure",
      "execution.output",
      "evidence.manifests",
      "evidence.retention_control",
      "context.advisory",
      "context.required_before_start",
      "context.required_before_transition",
      "context.shared_jobs",
      "context.updates",
      "context.expand",
      "execution.context_revalidation",
      "execution.evidence_outputs",
      "evidence.work_binding",
      "verification.jobs",
      "verification.record",
      "context.claims",
      "execution.claim_revalidation"
    ],
    "test_controls": [
      "clock.file",
      "executor.script",
      "store.faults",
      "evidence.store",
      "context.script",
      "knowledge.store",
      "verifier.script"
    ],
    "test_barriers": [
      "subscription.recheck.after_authorization",
      "session.closed",
      "backpressure.limit.reached",
      "backpressure.connection.closed",
      "backpressure.stall.started"
    ]
  },
  "launch": {
    "argv": [
      "{repo}/target/debug/combraton-reference-provider",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}",
      "--schemas",
      "{repo}/schemas",
      "--socket",
      "{socket_path}"
    ]
  },
  "mutants": {
    "argv": [
      "--mutant",
      "{mutant}"
    ],
    "names": [
      "skip-authentication",
      "distinguishable-auth-failure",
      "revoked-credential-accepted",
      "echo-credential",
      "unchecked-socket-directory",
      "no-cross-session-delivery",
      "idle-subscriptions-not-rechecked",
      "recheck-outside-lock",
      "clock-file-ignored",
      "clock-file-start-unchecked",
      "executor-ticks-only-on-requests",
      "cancels-on-session-close",
      "output-dropped-silently",
      "lost-range-without-bytes",
      "consumer-too-slow-to-older-consumers",
      "notice-waits-indefinitely",
      "unbounded-pending-output",
      "semantic-events-dropped-under-pressure",
      "notice-budget-per-subscription",
      "room-wait-unbounded",
      "packet-reported-before-seal",
      "foreign-grant-honored",
      "packet-grant-covers-all-packets",
      "packet-reference-unchecked",
      "output-listed-unsealed",
      "output-digest-differs",
      "context-outage-fails-open",
      "unmet-packet-satisfies",
      "context-queued-holds-capacity",
      "job-execution-re-enriched",
      "cancel-ends-job",
      "admission-check-only",
      "no-late-state",
      "blocked-dispatch-holds-capacity",
      "fetched-digest-unchecked",
      "current-requirement-ignored",
      "supersession-always-stale",
      "pinned-ignores-correction",
      "newer-revision-substituted",
      "unavailable-knowledge-valid",
      "claim-revalidation-ignored",
      "advisory-blocked-by-claims"
    ]
  }
}
