{
  "format": "combraton-conformance-participant/1",
  "name": "combraton-reference-provider",
  "version": "0.1.0-dev.0",
  "description": "Reference Core provider (not a product). Build first: cargo build -p combraton-reference-provider",
  "role": "provider",
  "binding": "stdio",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      },
      {
        "name": "execution",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities",
      "core.effects",
      "execution.steering",
      "execution.actions",
      "execution.controller",
      "execution.workspaces",
      "execution.usage",
      "execution.context",
      "execution.discovery",
      "execution.continuation",
      "core.events.backpressure",
      "execution.output"
    ],
    "test_controls": [
      "clock.file",
      "executor.script",
      "store.faults"
    ],
    "test_barriers": [
      "backpressure.limit.reached",
      "backpressure.connection.closed"
    ]
  },
  "launch": {
    "argv": [
      "{repo}/target/debug/combraton-reference-provider",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}",
      "--schemas",
      "{repo}/schemas"
    ]
  },
  "mutants": {
    "argv": [
      "--mutant",
      "{mutant}"
    ],
    "names": [
      "unknown-method-negotiation-required",
