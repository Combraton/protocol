{
  "format": "combraton-conformance-participant/1",
  "name": "combraton-reference-provider",
  "version": "0.1.0-dev.0",
  "description": "Reference Core provider (not a product). Build first: cargo build -p combraton-reference-provider",
  "role": "provider",
  "binding": "stdio",
  "claims": {
    "profiles": [
      {
        "name": "core",
        "major": 1
      },
      {
        "name": "core-test",
        "major": 1
      }
    ],
    "features": [
      "core.grants",
      "core.events",
      "core.capabilities"
    ]
  },
  "launch": {
    "argv": [
      "{repo}/target/debug/combraton-reference-provider",
      "--data-dir",
      "{data_dir}",
      "--config",
      "{config_file}",
      "--schemas",
      "{repo}/schemas"
    ]
  },
  "mutants": {
    "argv": [
      "--mutant",
      "{mutant}"
    ],
    "names": [
      "ignore-capability-loss",
      "capability-loss-blocks-replay",
      "unknown-capability-as-supported",
      "capability-revision-static",
      "events-not-recorded",
      "event-sequence-gap",
      "drop-caused-by",
      "cursor-skips-last",
      "accept-foreign-cursor",
      "silent-retention-gap",
      "silent-epoch-change",
      "events-ignore-authorization",
      "volatile-events",
      "subscription-misses-backlog",
      "replay-appends-event",
      "ignore-grants",
      "ignore-grant-scope",
      "ignore-revocation",
      "ignore-expiry",
      "no-revocation-cascade",
      "allow-delegation-escalation",
      "leak-existence",
      "global-dedupe-scope",
      "ignore-grant-epoch-binding",
      "deny-replay-after-revocation",
      "accept-any-holder",
      "ignore-audience",
      "grant-visible-to-all",
      "reexecute-duplicates",
      "ignore-command-digest",
      "dedupe-by-transport-id",
      "ignore-generation-window",
      "checks-before-dedupe",
      "bind-on-rejection",
      "lose-dedupe-on-restart",
      "ignore-authority-epoch",
      "partial-preconditions",
      "accept-unknown-fields",
      "ignore-requires",
      "skip-digest-verification",
      "canonical-code-point-order",
      "canonical-ascii-escape",
      "unbounded-frames",
      "skip-invalid-frames",
      "parse-unterminated",
      "process-notifications",
      "accept-unsupported-profile",
      "no-negotiation-gate",
      "ignore-limits",
      "allow-renegotiation",
      "ignore-profile-selection",
      "accept-duplicate-members",
      "lax-numbers",
      "ignore-major-version",
      "ignore-negotiation-features",
      "ignore-preconditions",
      "expose-control-endpoint",
      "close-on-invalid-request",
      "strict-off-by-one-limit",
      "route-by-operation"
    ]
  }
}
