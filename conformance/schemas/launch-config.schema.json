{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/conformance/schemas/launch-config.schema.json",
  "title": "Conformance launch configuration (combraton-conformance-config/1)",
  "type": "object",
  "required": [
    "format"
  ],
  "properties": {
    "format": {
      "const": "combraton-conformance-config/1"
    },
    "principal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "authority_principals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "provider_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_string_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_array_items": {
          "type": "integer",
          "minimum": 1
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "dedupe": {
      "type": "object",
      "properties": {
        "advance_on_start": {
          "type": "integer",
          "minimum": 0
        },
        "retain_generations": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "new_epoch_on_start": {
          "type": "boolean"
        },
        "unvouched_last": {
          "type": "integer",
          "minimum": 0
        },
        "retain_last": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "supported",
          "unsupported",
          "unknown"
        ]
      }
    },
    "clock": {
      "type": "object",
      "properties": {
        "fixed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "description": "Path of a clock file the runner replaces atomically (decision 007)."
        }
      },
      "additionalProperties": false,
      "maxProperties": 1
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "credential"
        ],
        "properties": {
          "credential": {
            "type": "string",
            "pattern": "^ccred1\\.[A-Za-z0-9][A-Za-z0-9._:~-]{0,127}\\.[A-Za-z0-9_-]{43}$",
            "maxLength": 200
          },
          "revoked": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "test_barriers": {
      "type": "object",
      "required": [
        "directory",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        }
      },
      "description": "Implementation-specific barriers enabled for this launch (decision 007)."
    },
    "executor": {
      "type": "object",
      "description": "Scripted executor test adapter (decision 007, owner decision Q4): adapter capabilities and per-execution harness scripts. Normative only for the conformance tests that use it.",
      "properties": {
        "adapter": {
          "type": "object",
          "properties": {
            "enforcement": {
              "enum": [
                "enforced",
                "mediated",
                "cooperative"
              ]
            },
            "echo_proves_delivery": {
              "type": "boolean"
            },
            "predicates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "status"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "enum": [
                      "supported",
                      "unsupported",
                      "unknown"
                    ]
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "scripts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/script"
          }
        },
        "default_script": {
          "$ref": "#/$defs/script"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "script": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "deliver": {
            "enum": [
              "provider_ack_id",
              "echo",
              "transport_only",
              "bytes_written"
            ]
          },
          "crash": {
            "enum": [
              "before_dispatch",
              "after_write"
            ]
          },
          "reconcile_finds": {
            "enum": [
              "delivered",
              "not_delivered",
              "unknown"
            ]
          },
          "runtime": {
            "enum": [
              "preparing",
              "active",
              "requires_action",
              "quiescent",
              "exited",
              "unknown"
            ]
          },
          "host_restart": {
            "const": true
          },
          "complete": {
            "type": "object",
            "required": [
              "completion_id",
              "content"
            ],
            "properties": {
              "completion_id": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "generation": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "exit": {
            "type": "object"
          },
          "on_cancel": {
            "enum": [
              "cancelled",
              "refused",
              "not_supported",
              "unknown"
            ]
          },
          "wait_until": {
            "type": "string"
          },
          "wait_for": {
            "const": "cancel"
          },
          "stall": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}
