{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/core/1/common.schema.json",
  "title": "Core/1 shared definitions (Protocol 0.1 draft)",
  "$defs": {
    "safe_nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "identifier": {
      "description": "Caller- or provider-chosen opaque identifier. Printable ASCII subset avoids Unicode normalization ambiguity.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:~-]{0,127}$"
    },
    "dotted_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9_-]*)+$",
      "maxLength": 128
    },
    "operation_name": {
      "$ref": "#/$defs/dotted_name"
    },
    "subject_kind": {
      "$ref": "#/$defs/dotted_name"
    },
    "profile_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "profile_major": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "feature_name": {
      "description": "<profile>.<feature>; never contains a slash.",
      "$ref": "#/$defs/dotted_name"
    },
    "extension_key": {
      "description": "<domain>/<name>; exactly one slash.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+/[a-z][a-z0-9_.-]{0,63}$"
    },
    "digest": {
      "description": "Algorithm-qualified lowercase-hex digest (ENCODING section 3). Length per algorithm is checked semantically.",
      "type": "string",
      "pattern": "^[a-z0-9]+([+._-][a-z0-9]+)*:[0-9a-f]+$",
      "maxLength": 256
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/subject_kind"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "unevaluatedProperties": false
    },
    "revision": {
      "$ref": "#/$defs/safe_nonnegative_integer"
    },
    "precondition": {
      "type": "object",
      "required": [
        "subject",
        "revision"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "unevaluatedProperties": false
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/feature_name"
          },
          {
            "$ref": "#/$defs/extension_key"
          }
        ]
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/extension_key"
      },
      "maxProperties": 64
    },
    "party": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "unevaluatedProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_frame_bytes",
        "max_payload_bytes",
        "max_string_bytes",
        "max_array_items",
        "max_depth"
      ],
      "properties": {
        "max_frame_bytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 9007199254740991
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_string_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_array_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "unevaluatedProperties": false
    },
    "dedupe_window": {
      "type": "object",
      "required": [
        "oldest_retained",
        "current"
      ],
      "properties": {
        "oldest_retained": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        },
        "current": {
          "$ref": "#/$defs/safe_nonnegative_integer"
        }
      },
      "unevaluatedProperties": false
    },
    "acknowledgment": {
      "type": "object",
      "required": [
        "command_id",
        "command_digest",
        "operation_ref",
        "subject",
        "revision",
        "effect_refs"
      ],
      "properties": {
        "command_id": {
          "$ref": "#/$defs/identifier"
        },
        "command_digest": {
          "$ref": "#/$defs/digest"
        },
        "operation_ref": {
          "$ref": "#/$defs/identifier"
        },
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "effect_refs": {
          "type": "array",
          "maxItems": 0
        }
      },
      "unevaluatedProperties": false
    },
    "principal": {
      "$ref": "#/$defs/identifier"
    },
    "instant": {
      "description": "UTC instant, second precision, evaluated against the provider's clock.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "right_name": {
      "$ref": "#/$defs/dotted_name"
    },
    "resource": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/subject_kind"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "id_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:~-]{1,128}$"
        }
      },
      "not": {
        "required": [
          "id",
          "id_prefix"
        ]
      },
      "unevaluatedProperties": false
    },
    "grant_terms": {
      "type": "object",
      "required": [
        "holder",
        "audience",
        "rights",
        "resources",
        "delegation"
      ],
      "properties": {
        "holder": {
          "$ref": "#/$defs/principal"
        },
        "audience": {
          "$ref": "#/$defs/identifier"
        },
        "rights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/right_name"
          }
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "expires_at": {
          "$ref": "#/$defs/instant"
        },
        "authority_binding": {
          "type": "object",
          "required": [
            "scope",
            "epoch"
          ],
          "properties": {
            "scope": {
              "$ref": "#/$defs/identifier"
            },
            "epoch": {
              "$ref": "#/$defs/safe_nonnegative_integer"
            }
          },
          "unevaluatedProperties": false
        },
        "delegation": {
          "type": "object",
          "required": [
            "allowed",
            "max_depth"
          ],
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "max_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            }
          },
          "unevaluatedProperties": false
        },
        "parent": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "grant_record": {
      "type": "object",
      "required": [
        "id",
        "issuer",
        "holder",
        "audience",
        "rights",
        "resources",
        "delegation",
        "state"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/grant_terms"
        }
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "issuer": {
          "$ref": "#/$defs/principal"
        },
        "state": {
          "enum": [
            "active",
            "revoked"
          ]
        }
      },
      "unevaluatedProperties": false
    }
  }
}
