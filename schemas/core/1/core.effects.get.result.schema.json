{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Combraton/protocol/schemas/core/1/core.effects.get.result.schema.json",
  "title": "core.effects.get result",
  "type": "object",
  "required": [
    "effect",
    "status",
    "observations",
    "obligations"
  ],
  "properties": {
    "effect": {
      "$ref": "../../core/1/common.schema.json#/$defs/effect_descriptor"
    },
    "status": {
      "$ref": "../../core/1/common.schema.json#/$defs/effect_status"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../../core/1/common.schema.json#/$defs/effect_observation"
      }
    },
    "obligations": {
      "type": "array",
      "items": {
        "$ref": "../../core/1/common.schema.json#/$defs/obligation"
      }
    }
  },
  "unevaluatedProperties": false
}
